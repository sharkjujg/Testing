# Twitch (https://dev.twitch.tv/console) - app credentials, used to find clips
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok Content Posting API (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Initial tokens from your OAuth flow (scope: video.publish / video.upload).
# After the first refresh, clipforge keeps the rotated tokens in its SQLite db.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
